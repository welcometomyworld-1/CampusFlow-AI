# CAMPUSFLOW AI - Environment Configuration

# Application & Environment
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1
SECRET_KEY=campusflow-secret-super-secure-key-2026-hackathon
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AWS Configuration (AWS Builder Track & Bedrock Integration)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_KNOWLEDGE_BASE_ID=

# Amazon DynamoDB
DYNAMODB_TABLE_PREFIX=campusflow_
USE_DYNAMODB=False

# Amazon S3
S3_BUCKET_NAME=campusflow-academic-documents
USE_S3=False

# Amazon Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
USE_COGNITO=False

# MCP Server Configuration (Streamable HTTP)
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://127.0.0.1:8001
MCP_API_KEY=mcp_campusflow_secret_token_hackathon_2026

# Database
DATABASE_URL=sqlite:///./campusflow.db

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_MCP_URL=http://127.0.0.1:8001
